            "en": "Sam",
            "zh": "Sam"
          },
          "text": {
            "de": "Piet!",
            "en": "Piet!",
            "zh": "Piet！"
          }
        },
        {
          "id": 2,
          "panel": 1,
          "type": "speech",
          "speaker": {
            "de": "Piet",
            "en": "Piet",
            "zh": "Piet"
          },
          "text": {
            "de": "Sam!",
            "en": "Sam!",
            "zh": "Sam！"
          }
        },
        {
          "id": 3,
          "panel": 3,
          "type": "speech",
          "speaker": {
            "de": "Piet",
            "en": "Piet",
            "zh": "Piet"
          },
          "text": {
            "de": "Ich hab dich überall gesucht!",
            "en": "I've looked everywhere for you!",
            "zh": "我到处都在找你！"
          }
        },
        {
          "id": 4,
          "panel": 3,
          "type": "speech",
          "speaker": {
            "de": "Sam",
            "en": "Sam",
            "zh": "Sam"
          },
          "text": {
            "de": "Ich hab auf dich gewartet.",
            "en": "I've been waiting for you.",
            "zh": "我一直在等你。"
          }
        },
        {
          "id": 5,
          "panel": 4,
          "type": "speech",
          "speaker": {
            "de": "Piet",
            "en": "Piet",
            "zh": "Piet"
          },
          "text": {
            "de": "Wo warst du?!",
            "en": "Where have you been?!",
            "zh": "你到底去哪儿了？！"
          }
        },
        {
          "id": 6,
          "panel": 5,
          "type": "speech",
          "speaker": {
            "de": "Sam",
            "en": "Sam",
            "zh": "Sam"
          },
          "text": {
            "de": "In einer Schildkröte.",
            "en": "Inside a turtle.",
            "zh": "在一只海龟肚子里。"
          }
        },
        {
          "id": 7,
          "panel": 5,
          "type": "speech",
          "speaker": {
            "de": "Piet",
            "en": "Piet",
            "zh": "Piet"
          },
          "text": {
            "de": "Das ist keine Antwort.",
            "en": "That's not an answer.",
            "zh": "这算什么回答啊。"
          }
        },
        {
          "id": 8,
          "panel": 5,
          "type": "speech",
          "speaker": {
            "de": "Sam",
            "en": "Sam",
            "zh": "Sam"
          },
          "text": {
            "de": "Leider doch.",
            "en": "Unfortunately, it is.",
            "zh": "可惜这是真的。"
          }
        }
      ]
    },
    "08": {
      "review_status": "source_transcribed",
      "summary": {
        "de": "Piet sucht Hilfe bei Klaus Störtebeker, während Sam auf dem Floß bleibt.",
        "en": "Piet sets off to find help from Klaus Störtebeker while Sam stays aboard the raft.",
        "zh": "Piet 前往寻找 Klaus Störtebeker 帮忙，Sam 留在木筏上。"
      },
      "dialogues": [
        {
          "id": 1,
          "panel": 1,
          "type": "speech",
          "speaker": {
            "de": "Piet",
            "en": "Piet",
            "zh": "Piet"
          },
          "text": {
            "de": "Äh ... Sam?",
            "en": "Um... Sam?",
            "zh": "呃……Sam？"
          }
        },
        {
          "id": 2,
          "panel": 1,
          "type": "speech",
          "speaker": {
            "de": "Sam",
            "en": "Sam",
            "zh": "Sam"
          },
          "text": {
            "de": "Hm?",
            "en": "Hmm?",
            "zh": "嗯？"
          }
        },
        {
          "id": 3,
          "panel": 2,
          "type": "speech",
          "speaker": {
            "de": "Piet",
            "en": "Piet",
            "zh": "Piet"
          },
          "text": {
            "de": "Du treibst ja nur!",
            "en": "You're just drifting!",
            "zh": "你一直在漂着呀！"
          }
        },
        {
          "id": 4,
          "panel": 2,
          "type": "speech",
          "speaker": {
            "de": "Sam",
            "en": "Sam",
            "zh": "Sam"
          },
          "text": {
            "de": "Ich hatte andere Prioritäten.",
            "en": "I had other priorities.",
            "zh": "我还有更重要的事。"
          }
        },
        {
          "id": 5,
          "panel": 3,
          "type": "speech",
          "speaker": {
            "de": "Piet",
            "en": "Piet",
            "zh": "Piet"
          },
          "text": {
            "de": "Wir brauchen Klaus Störtebeker.",
            "en": "We need Klaus Störtebeker.",
            "zh": "我们需要 Klaus Störtebeker 的帮助。"
          }
        },
        {
          "id": 6,
          "panel": 3,
          "type": "speech",
          "speaker": {
            "de": "Sam",
            "en": "Sam",
            "zh": "Sam"
          },
          "text": {
            "de": "Die kleine Schildkröte?",
            "en": "The little turtle?",
            "zh": "那只小海龟？"
          }
        },
        {
          "id": 7,
          "panel": 4,
          "type": "speech",
          "speaker": {
            "de": "Piet",
            "en": "Piet",
            "zh": "Piet"
          },
          "text": {
            "de": "Genau. Bleib hier!",
            "en": "Exactly. Stay here!",
            "zh": "对。你待在这里！"
          }
        },
        {
          "id": 8,
          "panel": 4,
          "type": "speech",
          "speaker": {
            "de": "Sam",
            "en": "Sam",
            "zh": "Sam"
          },
          "text": {
            "de": "Als hätte ich gerade viel Auswahl.",
            "en": "As if I had much choice.",
            "zh": "说得好像我还有别的选择似的。"
          }
        },
        {
          "id": 9,
          "panel": 5,
          "type": "speech",
          "speaker": {
            "de": "Piet",
            "en": "Piet",
            "zh": "Piet"
          },
          "text": {
            "de": "Ich bin gleich zurück!",
            "en": "I'll be right back!",
            "zh": "我马上回来！"
          }
        },
        {
          "id": 10,
          "panel": 5,
          "type": "speech",
          "speaker": {
            "de": "Sam",
            "en": "Sam",
            "zh": "Sam"
          },
          "text": {
            "de": "Ich zähle drauf.",
            "en": "I'm counting on it.",
            "zh": "那就靠你了。"
          }
        }
      ]
    },
    "09A": {
      "review_status": "source_transcribed",
      "summary": {
        "de": "Piet bringt Störtebeker zur Rettung. Sie sichern das Floß und steuern die Insel an.",
        "en": "Piet brings Störtebeker to help, secures the raft and sets course for the island.",
        "zh": "Piet 找来 Störtebeker 帮忙，把木筏系好后一起驶向小岛。"
      },
      "dialogues": [
        {
          "id": 1,
          "panel": 1,
          "type": "speech",
          "speaker": {
            "de": "Sam",
            "en": "Sam",
            "zh": "Sam"
          },
          "text": {
            "de": "Pass auf dich auf, Piet!",
            "en": "Take care, Piet!",
            "zh": "Piet，小心点！"
          }
        },
        {
          "id": 2,
          "panel": 1,
          "type": "speech",
          "speaker": {
            "de": "Piet",
            "en": "Piet",
            "zh": "Piet"
          },
          "text": {
            "de": "Ich bin schnell wieder da!",
            "en": "I'll be back in no time!",
            "zh": "我很快就回来！"
          }
        },
        {
          "id": 3,
          "panel": 2,
          "type": "speech",
          "speaker": {
            "de": "Piet",
            "en": "Piet",
            "zh": "Piet"
          },
          "text": {
            "de": "Klaus! Wir brauchen deine Hilfe!",
            "en": "Klaus! We need your help!",
            "zh": "Klaus！我们需要你帮忙！"
          }
        },
        {
          "id": 4,
          "panel": 3,
          "type": "speech",
          "speaker": {
            "de": "Piet",
            "en": "Piet",
            "zh": "Piet"
          },
          "text": {
            "de": "Los, Störtebeker! Sam wartet schon!",
            "en": "Come on, Störtebeker! Sam is waiting!",
            "zh": "快点，Störtebeker！Sam 还在等我们！"
          }
        },
        {
          "id": 5,
          "panel": 3,
          "type": "speech",
          "speaker": {
            "de": "Störtebeker",
            "en": "Störtebeker",
            "zh": "斯特尔特贝克"
          },
          "text": {
            "de": "Klar doch! Volle Kraft voraus!",
            "en": "Sure thing! Full speed ahead!",
            "zh": "没问题！全速前进！"
          }
        },
        {
          "id": 6,
          "panel": 5,
          "type": "speech",
          "speaker": {
            "de": "Sam",
            "en": "Sam",
            "zh": "Sam"
          },
          "text": {
            "de": "Da seid ihr!",
            "en": "There you are!",
            "zh": "你们终于来了！"
          }
        },
        {
          "id": 7,
          "panel": 5,
          "type": "speech",
          "speaker": {
            "de": "Piet",
            "en": "Piet",
            "zh": "Piet"
          },
          "text": {
            "de": "Sam! Wir sind da!",
            "en": "Sam! We're here!",
            "zh": "Sam！我们来了！"
          }
        },
        {
          "id": 8,
          "panel": 6,
          "type": "speech",
          "speaker": {
            "de": "Sam",
            "en": "Sam",
            "zh": "Sam"
          },
          "text": {
            "de": "So, fest! Das hält.",
            "en": "There, tied tight! It'll hold.",
            "zh": "好了，绑紧了！应该牢靠了。"
          }
        },
        {
          "id": 9,
          "panel": 6,
          "type": "speech",
          "speaker": {
            "de": "Störtebeker",
            "en": "Störtebeker",
            "zh": "斯特尔特贝克"
          },
          "text": {
            "de": "Bereit, Mannschaft?",
            "en": "Ready, crew?",
            "zh": "船员们，准备好了吗？"
          }
        },
        {
          "id": 10,
          "panel": 7,
          "type": "speech",
          "speaker": {
            "de": "Piet",
            "en": "Piet",
            "zh": "Piet"
          },
          "text": {
            "de": "Dann los, Störtebeker!",
            "en": "Let's go, Störtebeker!",
            "zh": "出发吧，Störtebeker！"
          }
        },
        {
          "id": 11,
          "panel": 7,
          "type": "speech",
          "speaker": {
            "de": "Störtebeker",
            "en": "Störtebeker",
            "zh": "斯特尔特贝克"
          },
          "text": {
            "de": "Auf zur Insel!",
            "en": "To the island!",
            "zh": "向小岛进发！"
          }
        }
      ]
    },
    "09B": {
      "review_status": "source_transcribed",
      "summary": {
        "de": "Störtebeker zieht das Floß durch die Wellen. Die Freunde entdecken eine Insel und eine Hütte.",
        "en": "Störtebeker pulls the raft through the waves. The friends spot an island and a hut.",
        "zh": "Störtebeker 拉着木筏越过海浪，朋友们发现一座有小屋的岛屿。"
      },
      "dialogues": [
        {
          "id": 1,
          "panel": 1,
          "type": "speech",
          "speaker": {
            "de": "Sam",
            "en": "Sam",
            "zh": "Sam"
          },
          "text": {
            "de": "Bereit, Störtebeker?",
            "en": "Ready, Störtebeker?",
            "zh": "准备好了，Störtebeker？"
          }
        },
        {
          "id": 2,
          "panel": 1,
          "type": "speech",
          "speaker": {
            "de": "Störtebeker",
            "en": "Störtebeker",
            "zh": "斯特尔特贝克"
          },
          "text": {
            "de": "Immer doch!",
            "en": "Always!",
            "zh": "随时都准备好了！"
          }
        },
        {
          "id": 3,
          "panel": 2,
          "type": "speech",
          "speaker": {
            "de": "Sam",
            "en": "Sam",
            "zh": "Sam"
          },
          "text": {
            "de": "Los, Freund!",
            "en": "Let's go, my friend!",
            "zh": "出发吧，朋友！"
          }
        },
        {
          "id": 4,
          "panel": 3,
          "type": "speech",
          "speaker": {
            "de": "Sam",
            "en": "Sam",
            "zh": "Sam"
          },
          "text": {
            "de": "Wow! Du bist ja echt stark, Störtebeker!",
            "en": "Wow, you're really strong, Störtebeker!",
            "zh": "哇，Störtebeker，你可真有力气！"
          }
        },
        {
          "id": 5,
          "panel": 3,
          "type": "speech",
          "speaker": {
            "de": "Störtebeker",
            "en": "Störtebeker",
            "zh": "斯特尔特贝克"
          },
          "text": {
            "de": "Kleine Wellen? Kein Problem!",
            "en": "Little waves? No problem!",
            "zh": "这点小浪？没问题！"
          }
        },
        {
          "id": 6,
          "panel": 4,
          "type": "speech",
          "speaker": {
            "de": "Sam",
            "en": "Sam",
            "zh": "Sam"
          },
          "text": {
            "de": "Da vorne! Eine Insel!",
            "en": "Look ahead! An island!",
            "zh": "看前面！有座岛！"
          }
        },
        {
          "id": 7,
          "panel": 4,
          "type": "speech",
          "speaker": {
            "de": "Piet",
            "en": "Piet",
            "zh": "Piet"
          },
          "text": {
            "de": "Und eine Hütte!",
            "en": "And a hut!",
            "zh": "还有一间小屋！"
          }
        },
        {
          "id": 8,
          "panel": 4,
          "type": "speech",
          "speaker": {
            "de": "Störtebeker",
            "en": "Störtebeker",
            "zh": "斯特尔特贝克"
          },
          "text": {
            "de": "Dann haben wir es geschafft.",
            "en": "Then we've made it.",
            "zh": "那我们就成功了。"
          }
        },
        {
          "id": 9,
          "panel": 5,
          "type": "speech",
          "speaker": {
            "de": "Piet",
            "en": "Piet",
            "zh": "Piet"
          },
          "text": {
            "de": "Unser nächstes Abenteuer!",
            "en": "Our next adventure!",
            "zh": "我们的下一场冒险！"
          }
        }
      ]
    }
  }
}
